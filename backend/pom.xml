<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ── Parent ──────────────────────────────────────────────────────────── -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>   <!-- YOUR version — LTS, stable ecosystem -->
        <relativePath/>
    </parent>

    <!-- ── Project identity ────────────────────────────────────────────────── -->
    <groupId>com.rentalcar</groupId>
    <artifactId>rental-car-booking</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>rental-car-booking</name>
    <description>Production-grade Rental Car Booking Backend — merged codebase</description>
    <packaging>jar</packaging>

    <!-- ── Version properties ──────────────────────────────────────────────── -->
    <properties>
        <java.version>21</java.version>

        <!-- JWT — keep yours (0.12.5), both are API-compatible -->
        <jjwt.version>0.12.5</jjwt.version>

        <!-- Lombok — fixed version so annotation processor matches runtime -->
        <lombok.version>1.18.30</lombok.version>

        <!-- Testcontainers — yours -->
        <testcontainers.version>1.19.7</testcontainers.version>

        <!-- Springdoc OpenAPI — Swagger UI (yours; Deepak had none) -->
        <springdoc.version>2.4.0</springdoc.version>

        <!-- Micrometer Prometheus — Deepak's metrics export -->
        <micrometer.version>1.12.5</micrometer.version>

        <!-- Spring Retry — needed for @Retryable in BookingService -->
        <spring-retry.version>2.0.5</spring-retry.version>
    </properties>

    <!-- ── Dependencies ────────────────────────────────────────────────────── -->
    <dependencies>

        <!-- ════ Spring Boot Starters ═══════════════════════════════════════ -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <!-- includes spring-webmvc, jackson, tomcat, logging -->
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <!-- includes Hibernate 6, HikariCP, spring-tx -->
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <!-- Jakarta Bean Validation — @Valid, @NotNull, @ValidDateRange etc -->
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <!-- /actuator/health, /actuator/metrics, /actuator/prometheus -->
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
            <!-- AuditAspect — @Around pointcuts on service methods -->
            <!-- Deepak also had aspectjweaver explicit; Boot starter covers it -->
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <!-- Lettuce client + connection pool + RedisTemplate -->
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
            <!-- @Cacheable / @CacheEvict / @Caching annotations -->
        </dependency>

        <!-- ════ Database ════════════════════════════════════════════════════ -->

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
            <!-- runtime only — no compile-time dep needed -->
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <!-- Flyway core — schema versioning and migration -->
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <version>10.10.0</version>
            <!-- Deepak's addition — PostgreSQL-specific Flyway dialect.
                 Required in Boot 3.2+ for full Flyway PG support -->
        </dependency>

        <!-- ════ Messaging — Kafka ══════════════════════════════════════════ -->

        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
            <!-- KafkaTemplate, @KafkaListener, @RetryableTopic, @DltHandler -->
        </dependency>

        <!-- ════ JWT ════════════════════════════════════════════════════════ -->

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
            <!-- runtime only — API is coded against jjwt-api -->
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
            <!-- Jackson-based JSON serializer for JWT claims -->
        </dependency>

        <!-- ════ Retry ══════════════════════════════════════════════════════ -->

        <dependency>
            <groupId>org.springframework.retry</groupId>
            <artifactId>spring-retry</artifactId>
            <version>${spring-retry.version}</version>
            <!-- @Retryable on BookingService.create() for optimistic lock conflicts -->
        </dependency>

        <!-- ════ Metrics ════════════════════════════════════════════════════ -->

        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <version>${micrometer.version}</version>
            <!-- Exposes /actuator/prometheus for Grafana scraping.
                 MeterRegistry injected into BookingService for counters -->
        </dependency>

        <!-- ════ Code generation / utilities ════════════════════════════════ -->

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
            <!-- compile-time only — excluded from the final jar (see build plugin) -->
        </dependency>

        <!-- ════ API Documentation ══════════════════════════════════════════ -->

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
            <!-- Swagger UI at /swagger-ui.html, OpenAPI JSON at /api-docs -->
        </dependency>

        <!-- ════ Test dependencies ══════════════════════════════════════════ -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <!-- JUnit 5, Mockito, AssertJ, MockMvc -->
        </dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
            <!-- @WithMockUser, SecurityMockMvcRequestPostProcessors -->
        </dependency>

        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
            <!-- @EmbeddedKafka for integration tests -->
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
            <!-- @Testcontainers + @Container annotations -->
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
            <!-- Spins up a real PostgreSQL container for integration tests -->
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>kafka</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
            <!-- Spins up a real Kafka container for integration tests -->
        </dependency>

    </dependencies>

    <!-- ── Build ───────────────────────────────────────────────────────────── -->
    <build>
        <plugins>

            <!-- Spring Boot Maven plugin — creates executable fat jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.rentalcar.RentalCarApplication</mainClass>
                    <excludes>
                        <!-- Lombok is compile-time only — strip it from the fat jar -->
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Maven Compiler plugin — Java 21 + Lombok annotation processor -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                    <parameters>true</parameters>  <!-- preserves parameter names for Spring -->
                    <annotationProcessorPaths>
                        <!-- Lombok MUST come first — generates constructors/getters
                             that other processors (MapStruct etc) may depend on -->
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Surefire — runs JUnit 5 tests during mvn test -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>