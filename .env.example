# Copy to .env and fill in before running on EC2
# cp .env.example .env

# Database
DB_USER=vidhan
DB_PASSWORD=change_me_in_prod

# Redis (leave blank for no password)
REDIS_PASSWORD=

# JWT — MUST override in production
JWT_SECRET=replace_with_64_char_hex_string

# Optional overrides
BACKEND_PORT=8080
FRONTEND_PORT=80
COOKIE_SECURE=true